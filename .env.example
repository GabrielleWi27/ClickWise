# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed by scripts in supabase/seed-scripts/ (never used in the app
# itself, and must NEVER be committed or shipped to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
